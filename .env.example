# Google Cloud / BigQuery
GCP_PROJECT_ID=your-gcp-project-id
BQ_DATASET=mia
BQ_LOCATION=US
GA4_SOURCE=bigquery-public-data.ga4_obfuscated_sample_ecommerce
START_DATE=20201101
END_DATE=20210131

# AI layer: nvidia (free: Mistral, Qwen, Nemotron) | gemini (free) | openrouter | mistral | ollama | fal
LLM_PROVIDER=nvidia
LLM_API_KEY=
# fal.ai instead (same models, billed to fal credit): LLM_BASE_URL=https://fal.run/openrouter/router/openai/v1
# Local Ollama instead (private mode): LLM_BASE_URL=http://localhost:11434/v1
# Pick exact IDs with: python scripts/list_models.py
MODEL_A=
MODEL_B=
MODEL_PRIMARY=

# Email (Gmail app password, not your login password)
GMAIL_USER=
GMAIL_APP_PASSWORD=
