# Your Google Cloud project (BigQuery Sandbox is fine, no billing needed)
GCP_PROJECT_ID=your-gcp-project-id
# Dataset where the analytics layer is written (created automatically, US location)
BQ_DATASET=mia
BQ_LOCATION=US
# GA4 export to read from. Demo = Google's public sample.
# For a client, point this at their export, e.g. client-project.analytics_123456789
GA4_SOURCE=bigquery-public-data.ga4_obfuscated_sample_ecommerce
START_DATE=20201101
END_DATE=20210131
# LLM layer (Wednesday). OpenAI-compatible endpoint: OpenRouter (Mistral + Qwen) or local Ollama
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
